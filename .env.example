APP_ROLE=all
APP_INSTANCE_ID=local
PORT=3000
# Host ports used only by Docker Compose. These non-default values avoid
# colliding with a developer's PostgreSQL or LocalStack on 5432/4566.
API_HOST_PORT=3000
POSTGRES_HOST_PORT=55432
LOCALSTACK_HOST_PORT=45666
# Optional internal HTTP listener for a worker role; exposes /metrics and health.
# METRICS_PORT=9464
DATABASE_URL=postgresql://wager:wager@localhost:55432/wagering
SQS_ENDPOINT=http://localhost:45666
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
WAGER_QUEUE_URL=http://localhost:45666/000000000000/wager-transactions.fifo
WAGER_DLQ_QUEUE_URL=http://localhost:45666/000000000000/wager-transactions-dlq.fifo
WALLET_EVENTS_QUEUE_URL=http://localhost:45666/000000000000/wallet-events.fifo
PENDING_MAX_ATTEMPTS=10
PENDING_TTL_SECONDS=86400
PENDING_BACKOFF_BASE_SECONDS=5
PENDING_BACKOFF_MAX_SECONDS=3600
PENDING_CLAIM_SECONDS=60
PENDING_BATCH_SIZE=25
PENDING_POLL_MILLISECONDS=1000
OUTBOX_BACKOFF_BASE_SECONDS=1
OUTBOX_BACKOFF_MAX_SECONDS=300
OUTBOX_LEASE_SECONDS=60
OUTBOX_BATCH_SIZE=25
OUTBOX_POLL_MILLISECONDS=500
SQS_VISIBILITY_TIMEOUT_SECONDS=60
SQS_LONG_POLL_SECONDS=10
SQS_BATCH_SIZE=10
SQS_MAX_RECEIVE_ATTEMPTS=5
SQS_RETRY_BACKOFF_BASE_SECONDS=1
SQS_RETRY_BACKOFF_MAX_SECONDS=60
CONSUMER_SHUTDOWN_SECONDS=30
# Test-only crash hook. It is rejected unless RUN_CRASH_TEST=true.
# CRASH_AFTER_COMMIT_BEFORE_ACK_MESSAGE_ID=
