{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "scripts": {
    "start:dev": "bun --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "bun dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\" \"*.{json,md,yml}\"",
    "format": "prettier --write \"{src,test}/**/*.ts\" \"*.{json,md,yml}\"",
    "test": "bun test test/unit",
    "test:unit": "bun test test/unit",
    "test:integration": "RUN_INTEGRATION=true bun test test/integration",
    "test:critical": "RUN_INTEGRATION=true bun test test/unit test/integration",
    "migration:up": "bun src/migrations/run.ts up",
    "migration:down": "bun src/migrations/run.ts down"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.958.0",
    "@mikro-orm/core": "6.1.1",
    "@mikro-orm/migrations": "6.1.1",
    "@mikro-orm/nestjs": "6.1.1",
    "@mikro-orm/postgresql": "6.1.1",
    "@nestjs/common": "11.1.13",
    "@nestjs/core": "11.1.13",
    "@nestjs/platform-express": "11.1.13",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "decimal.js": "10.6.0",
    "pg": "8.16.3",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/bun": "1.3.5",
    "@types/express": "5.0.5",
    "@types/node": "24.10.1",
    "@typescript-eslint/eslint-plugin": "8.47.0",
    "@typescript-eslint/parser": "8.47.0",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
